---
interface FooterLink {
	href: string;
	label: string;
}

interface Props {
	footerLinks: FooterLink[];
}

const { footerLinks } = Astro.props;
---

<footer class="site__footer">
	<div class="site__footer-shell">
		<div class="site__footer-left">
			<a class="site__footer-brand" href="/">MAGGIE LYNN</a>
			<ul class="site__footer-utility" aria-label="Legal">
				<li><a class="site__footer-link" href="#">Privacy</a></li>
				<li><a class="site__footer-link" href="#">Terms</a></li>
				<li><a class="site__footer-link" href="#">Index</a></li>
				<li><a class="site__footer-link" href="#">Network</a></li>
			</ul>
		</div>
		<ul class="site__footer-nav">
			{footerLinks.map((item) => (
				<li>
					<a class="site__footer-link" href={item.href}>{item.label}</a>
				</li>
			))}
		</ul>
	</div>
</footer>
