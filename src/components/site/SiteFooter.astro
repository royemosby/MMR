---
interface FooterLink {
	href: string;
	label: string;
	external?: boolean;
}

interface Props {
	footerLinks: FooterLink[];
}

const { footerLinks } = Astro.props;
---

<footer class="site__footer">
	<div class="site__footer-shell">
		<div class="site__footer-left">
			<a class="site__footer-brand" href="/">MAGGIE LYNN</a>
			<p class="site__footer-descriptor">Strategic implementation and operations for complex, mission-driven work</p>
		</div>
		<ul class="site__footer-nav">
			{footerLinks.map((item) => (
				<li>
					<a
						class="site__footer-link"
						href={item.href}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener noreferrer' : undefined}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</div>
</footer>
