---
interface NavItem {
	href: string;
	label: string;
	external?: boolean;
	cta?: boolean;
}

interface Props {
	navigation: NavItem[];
	currentPath: string;
}

const { navigation, currentPath } = Astro.props;
---

<header class="site__masthead" id="site-masthead">
	<a class="site__brand" href="/">MAGGIE LYNN</a>
	<div class="site__nav">
		<nav aria-label="Primary">
			<ul class="nav-list">
				{navigation.map((item) => {
					const itemPath = item.href === '/' ? '/' : item.href.replace(/\/$/, '');
					const isCurrent = !item.external && currentPath === itemPath;
					const externalAttrs = item.external
						? { target: '_blank', rel: 'noopener noreferrer' }
						: {};

					return (
						<li class="nav-list__item">
							<a
								class:list={[item.cta ? 'nav-list__cta' : 'nav-list__link']}
								href={item.href}
								aria-current={isCurrent ? 'page' : undefined}
								{...externalAttrs}
							>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
	</div>
</header>

<script>
	const masthead = document.getElementById('site-masthead');
	if (masthead) {
		const observer = new IntersectionObserver(
			([entry]) => {
				masthead.classList.toggle('site__masthead--scrolled', !entry.isIntersecting);
			},
			{ rootMargin: '0px 0px 0px 0px', threshold: 0 }
		);
		// Sentinel element placed above the header in the document
		const sentinel = document.createElement('div');
		sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none;';
		document.body.prepend(sentinel);
		observer.observe(sentinel);
	}
</script>
