---
interface Props {
	title: string;
	summary?: string;
	href?: string;
	external?: boolean;
	date?: string;
	noteLabel?: string;
}

const {
	title,
	summary,
	href,
	external = false,
	date,
	noteLabel = 'Field Note'
} = Astro.props;

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article class="field-note-card">
	<p class="field-note-card__id">{noteLabel}</p>
	<h3 class="field-note-card__title">
		{href
			? <a class="field-note-card__link" href={href} {...externalAttrs} aria-label={external ? `${title} (opens in new tab)` : undefined}>{title}{external && <span class="field-note-card__external" aria-hidden="true"> ↗</span>}</a>
			: title
		}
	</h3>
	{summary && <p class="field-note-card__summary">{summary}</p>}
	{date && <p class="field-note-card__date">{date}</p>}
</article>
