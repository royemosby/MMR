---
interface Props {
	eyebrow: string;
	headline: string;
	body: string[];
	linkLabel: string;
	linkHref: string;
}

const { eyebrow, headline, body, linkLabel, linkHref } = Astro.props;
---

<section class="editorial-statement">
	<p class="editorial-statement__eyebrow">{eyebrow}</p>
	<h2 class="editorial-statement__headline">{headline}</h2>
	<div class="editorial-statement__body">
		{body.map((paragraph) => <p>{paragraph}</p>)}
	</div>
	<a class="editorial-statement__link" href={linkHref}>{linkLabel} →</a>
</section>
