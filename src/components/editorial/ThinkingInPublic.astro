---
interface Props {
	eyebrow: string;
	headline: string;
	body: string[];
	linkLabel: string;
	linkHref: string;
	linkExternal?: boolean;
	topics: string[];
}

const { eyebrow, headline, body, linkLabel, linkHref, linkExternal = false, topics } = Astro.props;
const externalAttrs = linkExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<section class="thinking-in-public">
	<div class="thinking-in-public__main">
		<p class="thinking-in-public__eyebrow">{eyebrow}</p>
		<h2 class="thinking-in-public__headline">{headline}</h2>
		<div class="thinking-in-public__body">
			{body.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<a
			class="editorial-statement__link"
			href={linkHref}
			{...externalAttrs}
			aria-label={linkExternal ? `${linkLabel} (opens in new tab)` : undefined}
		>
			{linkLabel} →
		</a>
	</div>
	<aside class="thinking-in-public__sidebar" aria-label="Selected topics">
		<div class="topics-index">
			<p class="topics-index__label">Selected topics</p>
			{topics.map((topic) => <p class="topics-index__item">{topic}</p>)}
		</div>
	</aside>
</section>
