---
interface Props {
	eyebrow: string;
	headline: string;
	deck: string;
}

const { eyebrow, headline, deck } = Astro.props;
---

<section class="page-intro">
	<p class="page-intro__eyebrow">{eyebrow}</p>
	<h1 class="page-intro__headline">{headline}</h1>
	<p class="page-intro__deck">{deck}</p>
</section>
