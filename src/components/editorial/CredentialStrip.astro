---
interface Credential {
	label: string;
	primary: string;
	supporting?: string;
}

interface Props {
	credentials: Credential[];
}

const { credentials } = Astro.props;
---

<section class="credential-strip" aria-label="Credentials and context">
	<div class="credential-strip__grid">
		{credentials.map((c) => (
			<div class="credential-item">
				<p class="credential-item__label">{c.label}</p>
				<p class="credential-item__primary">{c.primary}</p>
				{c.supporting && <p class="credential-item__supporting">{c.supporting}</p>}
			</div>
		))}
	</div>
</section>
