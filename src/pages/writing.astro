---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="Writing"
	description="Essays, field notes, and long-form thinking on strategy, operating systems, and the work of leading complex digital initiatives."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Writing</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Essays &amp; field notes</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Editorial</p>
			<h2 class="content-panel__title">Thinking made visible.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
				Flagship essays, working notes, and field dispatches on the operating layer between
				strategy and execution.
			</p>
		</div>
	</section>
</ShowcaseLayout>
