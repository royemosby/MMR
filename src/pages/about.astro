---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="About"
	description="A placeholder biography page for background, values, and professional point of view."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Profile</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Background and point of view</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Biography</p>
			<h2 class="content-panel__title">Professional context and operating philosophy.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
			Use this page for a short professional biography, areas of expertise, and the perspective
			that shapes the work.
			</p>
		</div>
		<div class="content-panel__meta">
			<p>Focus<span class="content-panel__meta-value">Experience, values, methodology</span></p>
			<p>Suggested proof<span class="content-panel__meta-value">Credentials, milestones, affiliations</span></p>
			<p>Voice<span class="content-panel__meta-value">Measured, specific, credible</span></p>
		</div>
	</section>
</ShowcaseLayout>
