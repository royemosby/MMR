---
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="Field Notes"
	description="A placeholder archive for essays, observations, project notes, and process writing."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Writing</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Archive and notes</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Archive</p>
			<h2 class="content-panel__title">Essays, observations, and working notes.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
			Use this page to collect writing, updates, research fragments, and practical notes from the
			work.
			</p>
		</div>
		<div class="content-panel__meta">
			<p>Formats<span class="content-panel__meta-value">Essays, briefs, dispatches</span></p>
			<p>Cadence<span class="content-panel__meta-value">Ongoing archive</span></p>
			<p>Purpose<span class="content-panel__meta-value">Make process legible</span></p>
		</div>
	</section>
</ShowcaseLayout>
