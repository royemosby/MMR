---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('field-notes');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

type Props = { entry: CollectionEntry<'field-notes'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ShowcaseLayout title={entry.data.title} description={entry.data.metaDescription ?? entry.data.signal} noHero>
	<article>
		<p>{entry.data.seriesLabel} — No. {entry.data.fieldNoteNumber}</p>
		<h1>{entry.data.title}</h1>
		{entry.data.signal && <p>{entry.data.signal}</p>}
		<Content />
	</article>
</ShowcaseLayout>
