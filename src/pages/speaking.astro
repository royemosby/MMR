---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="Speaking"
	description="A placeholder speaking page for talks, workshops, panels, and upcoming appearances."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Appearances</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Talks and workshops</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Programming</p>
			<h2 class="content-panel__title">Talk topics, sessions, and booking information.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
			Use this page to list presentation topics, past events, media, and booking information.
			</p>
		</div>
		<div class="content-panel__meta">
			<p>Formats<span class="content-panel__meta-value">Keynotes, workshops, panels</span></p>
			<p>Assets<span class="content-panel__meta-value">Topics, recordings, testimonials</span></p>
			<p>Booking<span class="content-panel__meta-value">Inquiry and availability details</span></p>
		</div>
	</section>
</ShowcaseLayout>
