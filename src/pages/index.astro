---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import InterfaceButton from '../components/ui/InterfaceButton.astro';
import FieldNoteCard from '../components/ui/FieldNoteCard.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import CapabilityThreeUp from '../components/editorial/CapabilityThreeUp.astro';
import FeaturedCase from '../components/editorial/FeaturedCase.astro';
import ClosingCTA from '../components/editorial/ClosingCTA.astro';
---

<ShowcaseLayout
	title="I design the operating structure behind complex work."
	description="I help mission-driven organizations turn ambitious priorities into work people can actually move, through clear decisions, visible risk, workable governance, and enough shared context to act."
	eyebrow="Strategic implementation + operations"
	portraitSrc="/images/portrait-home.jpg"
	portraitAlt="Maggie Lynn standing in a library-lined interior"
>
	<Fragment slot="hero-cta">
		<InterfaceButton href="/work" variant="primary">Explore the work</InterfaceButton>
		<InterfaceButton href="https://maggielynn.substack.com/" variant="secondary">Read Field Notes</InterfaceButton>
	</Fragment>

	<EditorialStatement
		eyebrow="The operating structure behind trust"
		headline="Strategy doesn't become real on its own."
		body={[
			"The plan can be solid. The people can be capable. Everyone can even agree on what they're trying to do. Complex work still starts to drift when decisions don't hold, risk stays hidden, ownership gets fuzzy, or the meaning of the work changes without the operating structure changing with it.",
			"That middle layer is where I work: the place where priorities have to become decisions, decisions have to become coordinated action, and the organization finds out whether the system can actually carry what it has promised.",
			"I build the structures that help people know what matters, what changed, who decides, and what they're supposed to do next. Trust doesn't appear because everyone keeps showing up to the meeting. Trust has to be designed into the way the work moves: decisions that hold, risks that surface early, context people can find, and enough clarity for people to act without waiting for rescue."
		]}
		linkLabel="Why I work this way"
		linkHref="/about"
	/>

	<CapabilityThreeUp
		eyebrow="How I work"
		headline="I make complex work easier to see, decide, and sustain."
		capabilities={[
			{
				number: '01',
				title: 'Make complexity legible',
				body: 'I create the shared view: what matters, what changed, where risk is forming, and which decisions still need to hold.',
				inPractice: 'Portfolio health signals, durable decision records, executive updates, and narrative resets.'
			},
			{
				number: '02',
				title: 'Design the operating structure',
				body: 'I turn organizational priorities into roles, governance, working rhythms, and resource choices a cross-functional team can actually use.',
				inPractice: 'Governance models, resource plans, launch criteria, and operating cadences.'
			},
			{
				number: '03',
				title: 'Help change survive launch',
				body: "I design for adoption, continuity, handoff, and reinforcement so the work doesn't depend on one person remembering how everything works.",
				inPractice: 'Adoption plans, training structures, handoffs, and post-launch operating practices.'
			}
		]}
		sectionLinkLabel="See how this shows up in the work"
		sectionLinkHref="/work"
	/>

	<FeaturedCase
		label="Case Study"
		eyebrow="Featured Work"
		title="The Platform Was the Deliverable. Adoption Was the Work."
		summary="I led an approximately $1 million multiyear statewide referral-platform initiative, building the partner, rollout, and public-facing systems the technology needed to become useful in practice."
		ctaLabel="Explore the work"
		ctaHref="/work"
		comparison={{
			left: {
				heading: 'What we were building',
				body: 'A statewide digital platform designed to help families and practitioners find and connect with relevant services.'
			},
			right: {
				heading: 'What it would take to make it real',
				body: 'A coordinated rollout across organizational teams, community partners, communications, referral practices, and the people expected to use the system in their everyday work.'
			},
			closingLine: 'The technology was the deliverable. The operating system around it was the implementation.'
		}}
	/>

	<!-- Field Notes -->
	<!-- Field Notes -->
	<section class="field-notes-section">
		<header class="field-notes-section__header">
			<p class="field-notes-section__eyebrow">Field Notes</p>
			<h2 class="field-notes-section__headline">Notes from the machinery of complex work.</h2>
			<p class="field-notes-section__intro">Most of my writing begins with a small operational haunting: a decision no one remembers making, a weekly update that restores shared reality, or a scope change that is actually a change in what the work means. The metaphor gets us in the door. The operating insight is why we stay.</p>
		</header>
		<div class="field-notes-section__grid">
			<FieldNoteCard
				title="Every Project Needs a &#8220;Previously On&#8230;&#8221;"
				summary="A project recap isn't nostalgia. It's how the work remembers what happened, why it matters, and where the story is going next."
				href="https://maggielynn.substack.com/p/every-project-needs-a-previously"
				external={true}
			/>
			<FieldNoteCard
				title="The Weekly Update Is a Ritual"
				summary="A note on orientation, rhythm, and the recurring work of restoring shared reality."
				href="https://maggielynn.substack.com/p/field-note-the-weekly-update-is-a"
				external={true}
			/>
			<FieldNoteCard
				title="Designing the Experience of Delivery"
				summary="The systems around complex work don't just organize delivery. They shape whether people experience the work as clear, trustworthy, navigable, or quietly unsafe."
				href="https://maggielynn.substack.com/p/essay-designing-the-experience-of"
				external={true}
			/>
		</div>
		<div class="field-notes-section__footer">
			<a
				class="interface-button interface-button--secondary"
				href="https://maggielynn.substack.com/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>Read all Field Notes ↗</span>
			</a>
		</div>
	</section>

	<ClosingCTA
		eyebrow="Contact"
		headline="Good strategy deserves a system that can carry it."
		body="Tell me what the work is trying to become—and where it keeps getting stuck. I'm interested in senior leadership roles, speaking invitations, and conversations about strategic implementation, portfolio operations, transformation, and the operating structures that help mission-driven work survive contact with reality."
		ctaLabel="Start a conversation"
		ctaHref="/contact"
	/>
</ShowcaseLayout>
