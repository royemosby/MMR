---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="Frameworks"
	description="Strategic frameworks and repeatable operating models for mission-driven digital work."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Methods</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Strategic frameworks</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Frameworks</p>
			<h2 class="content-panel__title">Repeatable structures for complex work.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
				A collection of named frameworks for operating clarity, decision structure, and strategic
				momentum. Each framework is drawn from direct practice and designed to be adapted, not
				just applied.
			</p>
		</div>
	</section>
</ShowcaseLayout>
