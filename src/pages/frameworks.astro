---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import DataEntryForm from '../components/ui/DataEntryForm.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import FieldNoteCard from '../components/ui/FieldNoteCard.astro';
import InterfaceButton from '../components/ui/InterfaceButton.astro';
import InterfaceLink from '../components/ui/InterfaceLink.astro';
import StrategicHeroBlock from '../components/ui/StrategicHeroBlock.astro';
---

<ShowcaseLayout
	title="Frameworks"
	description="A placeholder page for methods, systems, and repeatable approaches behind the work."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">02</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Strategic Hero Blocks</span>
	</div>
	<section class="component-grid component-grid--two">
		<StrategicHeroBlock
			eyebrow="Editorial Variant"
			title="The New Standard for Strategic Operations."
			note="Ref. Archive 2024.V2"
		/>
		<StrategicHeroBlock
			title="Foundational Research"
			mediaSrc="https://images.unsplash.com/photo-1518002054494-3a6f94352e9d?auto=format&fit=crop&w=900&q=80"
			mediaAlt="Architectural wall with dramatic light"
			mediaCaption="CMS Mapping: hero_headline, hero_media_url, content_tag"
		/>
	</section>

	<div class="section-heading">
		<p class="section-heading__eyebrow">03</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Interface Controls</span>
	</div>
	<section class="controls-grid">
		<div class="controls-grid__group">
			<p class="controls-grid__label">Primary (Oxblood)</p>
			<InterfaceButton variant="primary">Default State</InterfaceButton>
			<InterfaceButton variant="primary">Hover / Focus</InterfaceButton>
			<InterfaceButton variant="primary" disabled={true}>Disabled State</InterfaceButton>
		</div>
		<div class="controls-grid__group">
			<p class="controls-grid__label">Secondary (Ghost)</p>
			<InterfaceButton variant="secondary">Default State</InterfaceButton>
			<InterfaceButton variant="secondary">Hover State</InterfaceButton>
			<InterfaceButton variant="secondary" disabled={true}>Disabled State</InterfaceButton>
		</div>
		<div class="controls-grid__group">
			<p class="controls-grid__label">Minimal (Link)</p>
			<InterfaceLink href="/field-notes">Explore Archive</InterfaceLink>
		</div>
	</section>

	<div class="section-heading">
		<p class="section-heading__eyebrow">04</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Information Containers</span>
	</div>
	<section class="component-grid component-grid--two">
		<FeatureCard
			title="Project Ivory: Operational Scalability for Multi-National Logistics"
			description="Mapping complex node-based distribution networks into an archival-friendly management interface."
			imageSrc="https://images.unsplash.com/photo-1531297484001-80022131f5a1?auto=format&fit=crop&w=900&q=80"
			imageAlt="Open technical notebook on a desk"
		/>
		<FieldNoteCard
			quote="The quiet between decisions is where the strategy actually lives."
			author="Authored by Maggie Lynn"
			date="03.14.24"
		/>
	</section>

	<div class="section-heading">
		<p class="section-heading__eyebrow">05</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Data Entry Systems</span>
	</div>
	<section class="form-shell">
		<DataEntryForm />
	</section>
</ShowcaseLayout>
