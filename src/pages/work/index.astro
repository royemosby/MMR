---
import { getCollection } from 'astro:content';
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
import EditorialPageHeader from '../../components/editorial/EditorialPageHeader.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import ClosingCTA from '../../components/editorial/ClosingCTA.astro';

const caseStudies = (await getCollection('work', ({ data }) => data.status === 'published'))
	.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<ShowcaseLayout
	title="Work"
	description="Selected case studies on operating interventions, digital transformation, and the operating layer between strategy and execution."
	noHero
>
	<EditorialPageHeader
		eyebrow="Work"
		heading="The plan is rarely the hard part."
		intro="I lead work where strategy has to survive shifting conditions, cross-functional ownership, technical constraints, and the realities of how people and organizations actually operate. Below, I share three examples of what that looks like at different points in the work: defining the direction, getting to launch, and building the systems that make change usable after the technology exists."
	/>

	{caseStudies.length > 0 && (
		<>
			<div class="section-heading">
				<p class="section-heading__eyebrow">Case Studies</p>
				<div class="section-heading__line"></div>
				<span class="section-heading__label">Selected engagements</span>
			</div>
			{caseStudies.map((study) => (
				<article class="work-teaser">
					<p class="work-teaser__eyebrow">
						<span class="work-teaser__category">{study.data.category}</span>
						{study.data.sector && <span class="work-teaser__sector">{study.data.sector}</span>}
					</p>
					<h2 class="work-teaser__title">
						<a class="work-teaser__link" href={`/work/${study.id}`}>{study.data.strategicTitle}</a>
					</h2>
					<p class="work-teaser__summary">{study.data.summary}</p>
					<a class="work-teaser__cta" href={`/work/${study.id}`} aria-label={`Read case study: ${study.data.strategicTitle}`}>
						Read the case study →
					</a>
				</article>
			))}
		</>
	)}

	<EditorialStatement
		eyebrow="The pattern"
		headline="Different work. Familiar failure modes."
		body={[
			"A statewide public-service platform, a museum launch, and a digital strategy engagement do not look particularly similar from the outside.",
			"Underneath, the same operating problems appear again and again. A decision exists, but people are working from different versions of it. Risk is obvious in conversation before it appears in formal reporting. A strategy changes, but the structure around the work does not. A new system launches, but nobody has designed what happens when real people start using it. A team has plenty of information and still cannot tell what matters most.",
			"That repetition is useful. It means I can look past the visible form of the project and start asking what the work actually needs: better decision structure, clearer ownership, shared context, stronger feedback loops, a more honest view of risk, or an operating model that can survive the next change."
		]}
	/>

	<ClosingCTA
		eyebrow="What\u2019s next"
		headline="I\u2019m interested in the work that gets complicated between the strategy and the outcome."
		body="I\u2019m interested in senior leadership roles, strategic initiatives, transformation, and conversations about how organizations make consequential work easier to see, decide, and carry forward."
		ctaLabel="Start a conversation"
		ctaHref="mailto:maggie@reasonablepeople.io"
		secondaryLinkLabel="More about how I work"
		secondaryLinkHref="/about"
	/>
