---
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
---

<ShowcaseLayout
	title="Work"
	description="A placeholder portfolio page for selected engagements, case studies, and outcomes."
>
	<div class="section-heading">
		<p class="section-heading__eyebrow">Portfolio</p>
		<div class="section-heading__line"></div>
		<span class="section-heading__label">Selected engagements</span>
	</div>
	<section class="content-panel">
		<header class="content-panel__header">
			<p class="content-panel__eyebrow">Case studies</p>
			<h2 class="content-panel__title">Selected work and measured outcomes.</h2>
		</header>
		<div class="content-panel__content">
			<p class="content-panel__body">
			Use this page to feature projects, case studies, and the measurable results of recent work.
			</p>
		</div>
		<div class="content-panel__meta">
			<p>Structure<span class="content-panel__meta-value">Challenge, approach, outcome</span></p>
			<p>Evidence<span class="content-panel__meta-value">Metrics, artifacts, testimonials</span></p>
			<p>Scope<span class="content-panel__meta-value">Selected highlights only</span></p>
		</div>
	</section>
</ShowcaseLayout>
