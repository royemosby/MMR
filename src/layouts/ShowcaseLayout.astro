---
import PageHero from '../components/site/PageHero.astro';
import PrimaryNav from '../components/site/PrimaryNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface NavItem {
	href: string;
	label: string;
	external?: boolean;
	cta?: boolean;
}

interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
	portraitSrc?: string;
	portraitAlt?: string;
	/** Pass noHero on pages that use an editorial header component (ArticleHeader,
	 * CaseStudyHeader, etc.) as their own page header instead of PageHero. */
	noHero?: boolean;
}

const {
	title,
	description = 'Professional showcase placeholder page.',
	eyebrow,
	portraitSrc,
	portraitAlt,
	noHero = false
} = Astro.props;

const navigation: NavItem[] = [
	{ href: '/about', label: 'About' },
	{ href: 'https://maggielynn.substack.com/', label: 'Field Notes', external: true },
	{ href: '/work', label: 'Work' },
	{ href: '/contact', label: 'Contact', cta: true }
];

const footerLinks: NavItem[] = [
	{ href: '/about', label: 'About' },
	{ href: 'https://maggielynn.substack.com/', label: 'Field Notes', external: true },
	{ href: '/work', label: 'Work' },
	{ href: '/contact', label: 'Contact' },
	{ href: '#', label: 'LinkedIn' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<style is:global>@import '../styles/foundation.css';</style>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | MMR</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="site">
			<div class="site__shell">
				<PrimaryNav navigation={navigation} currentPath={currentPath} />
				{!noHero && (
					<PageHero title={title} description={description} eyebrow={eyebrow} portraitSrc={portraitSrc} portraitAlt={portraitAlt}>
						<slot name="hero-cta" slot="cta" />
					</PageHero>
				)}
				<main class="site__main">
				<slot />
				</main>
			</div>
			<SiteFooter footerLinks={footerLinks} />
		</div>
	</body>
</html>
